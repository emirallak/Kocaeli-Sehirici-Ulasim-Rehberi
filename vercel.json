{
  "rewrites": [
    {
      "source": "/line-info",
      "destination": "/lines.html"
    },
    {
      "source": "/stop-info",
      "destination": "/stops.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "api/app/data/{raw/**,snapshot.pickle.xz}",
      "excludeFiles": "{tests/**,public/**,frontend/**,**/__pycache__/**}"
    }
  }
}
